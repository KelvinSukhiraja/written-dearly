NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
APP_URL=https://your-wedding-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# WhatsApp Business Cloud API. Disabled until template, SQL and live setup approval.
# All credentials stay server-side. Never prefix them with NEXT_PUBLIC_.
WHATSAPP_ENABLED=false
WHATSAPP_TEMPLATE_APPROVED=false
WHATSAPP_OWNER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Pin an API version supported by your Meta app; no implicit default.
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=wedding_invitation
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Backend-only Supabase secret key for delivery tracking; never a browser key.
SUPABASE_SECRET_KEY=
